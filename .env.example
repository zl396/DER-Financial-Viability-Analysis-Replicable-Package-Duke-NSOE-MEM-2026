# Copy this file to `.env` (which is gitignored) and fill in your own credentials.
# DO NOT commit `.env` to git.

# NSRDB API access (free) — register at https://developer.nrel.gov/signup/
# Used by: shared/fetch_nsrdb.py and per-state weather download steps.
NSRDB_API_KEY=your_free_key_here
NSRDB_EMAIL=your_email@example.com
